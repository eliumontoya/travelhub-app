{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/page.{ts,tsx}",
    "src/app/**/layout.{ts,tsx}",
    "src/app/**/route.{ts,tsx}",
    "src/middleware.ts",
    "scripts/**",
    "e2e/**",
    "sanity.config.mts"
  ],
  "project": ["src/**", "scripts/**"],
  "ignoreDependencies": ["@types/sanitize-html", "@types/qrcode", "@types/bcryptjs", "tailwindcss", "@tailwindcss/postcss", "eslint-config-next"],
  "ignoreBinaries": ["supabase"]
}
