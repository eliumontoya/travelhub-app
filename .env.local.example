# Copia este archivo a .env.local y llena los valores. Nunca commitees .env.local.

# --- Supabase (obligatorio para login real, datos persistentes y upload de documentos) ---
# Sin estas 3 variables, la app sigue funcionando con datos de prueba en memoria
# (ver src/lib/mock-data.ts) y el dashboard queda accesible sin login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps (opcional) ---
# Sin esta key: el campo de ubicación es un input de texto plano (sin
# autocomplete ni lat/lng) y el mapa en la vista pública es un link simple
# a Google Maps. Con la key: autocomplete de Places + mapa embebido.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
