# Copia este archivo a .env.local y llena los valores. Nunca commitees .env.local.

# --- Supabase (obligatorio para login real, datos persistentes y upload de documentos) ---
# Sin estas 3 variables, la app sigue funcionando con datos de prueba en memoria
# (ver src/lib/mock-data.ts) y el dashboard queda accesible sin login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps (opcional) ---
# Sin esta key: el campo de ubicación es un input de texto plano (sin
# autocomplete ni lat/lng) y el mapa en la vista pública es un link simple
# a Google Maps. Con la key: autocomplete de Places + mapa embebido.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Email / Recordatorios (opcional) ---
# Sin Resend: no se envían recordatorios automáticos antes del viaje.
RESEND_API_KEY=
EMAIL_FROM=
TRIP_REMINDER_DAYS_BEFORE=3
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=

# --- Flight status (opcional) ---
# Sin esta key: el badge de estado de vuelo no aparece.
# Con la key: aparece un botón "Estado del vuelo" en items de tipo flight.
FLIGHT_API_KEY=

# Duración del cache del estado de vuelo en el navegador (horas). Default: 24.
NEXT_PUBLIC_FLIGHT_STATUS_CACHE_HOURS=24
