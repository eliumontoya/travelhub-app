    {
      "dot": "emerald",
      "title": "Fast path first",
      "items": [
        "The API checks Redis before touching PostgreSQL.",
        "A cache hit would skip the database branch entirely."
      ]
    },
    {
      "dot": "amber",
      "title": "Miss behavior",
      "items": [
        "The cache miss makes PostgreSQL the authoritative fallback.",
        "The API fills Redis after reading the source of truth."
      ]
    },
    {
      "dot": "cyan",
      "title": "Response boundary",
      "items": [
        "The browser waits for the API response, not for a separate background worker.",
